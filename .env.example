# Local Node/SQLite backend, supports original R2 interface out of the box.
PORT=3100
HOST=127.0.0.1
DATABASE_PATH=./data/proof.sqlite
APP_ORIGIN=http://127.0.0.1:3100
NODE_ENV=development
PAYMENT_MODE=sandbox
IP_HASH_SECRET=replace-with-strong-independent-random-secret-at-least-32-chars
WEBHOOK_SECRET=replace-with-strong-independent-random-secret-at-least-32-chars
METRICS_SECRET=replace-with-strong-independent-random-secret-at-least-32-chars
TRUSTED_PROXY_IPS=
# Explicit local-only mode; tokens are returned by API in this mode. NEVER enable publicly.
EMAIL_TEST_MODE=0
# For separate Stripe TEST environment only: PAYMENT_MODE=stripe_test, NODE_ENV != production.
# STRIPE_TEST_SECRET_KEY=sk_test_...
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# For PostgreSQL CUTOVER ONLY, after review: PG_ADMIN_URL=postgresql://...
# ALLOW_SENSITIVE_EXPORT=I_UNDERSTAND
# ALLOW_PG_IMPORT=I_UNDERSTAND

# R4 signed email delivery: configure BOTH only for a reviewed provider (never use localhost).
# MAIL_DELIVERY_URL=https://mail-provider.example/verified-send
# MAIL_DELIVERY_SECRET=independent-secret-at-least-32-characters
# R4 AES-256-GCM backup key: 32 random bytes, base64 encoded, never committed.
# BACKUP_ENCRYPTION_KEY=
# OFFSITE_BACKUP_DESTINATION=s3://private-versioned-bucket/path
# TLS_TERMINATION_VERIFIED=0
# PAYOUTS_ENABLED=0
# Staging-only: the customer receives email challenges through an approved transport if configured.
